{
  "title": "ARCH brow measurement reference",
  "version": "1.3.1",
  "date": "2026-10-19",
  "frame_note": "All vertical measurements are taken in the eye-line frame \u2014 the line from the inner to the outer corner of the eye, treated as horizontal. These figures are not comparable to the stylist convention of true horizontal.",
  "units": "All lengths, heights and thicknesses are ratios of eye width. Eye width = 1.0. Peak position and peak adjustments are percentages of brow length.",
  "eye_width": "Distance from the inner corner to the outer corner of the eye opening.",
  "axes": "Eye-line frame. x runs parallel to the eye line (inner corner to outer corner of the eye opening), from Head to Tail. y runs perpendicular to the eye line, positive toward the brow. Head is the origin.",
  "reference_points": {
    "head": "Inner end of the brow.",
    "tail": "Outer end of the brow.",
    "peak": "Highest point of the upper edge. Where the top is flat, the centre of the flat run.",
    "body": "Thickest section."
  },
  "measures": {
    "length_ew": "Distance from Head to Tail along x (parallel to the eye line).",
    "peak_position_pct_from_head": "Distance from Head to Peak along x, as a percentage of Length.",
    "peak_height_ew": "Distance from Head up to Peak along y (perpendicular to the eye line).",
    "thickness_head_ew": "Thickness perpendicular to the brow line, 10% of Length from Head.",
    "thickness_body_ew": "Thickness perpendicular to the brow line at the thickest section.",
    "thickness_tail_ew": "Thickness perpendicular to the brow line, 90% of Length from Head (10% from Tail).",
    "tail_vs_head": "Offset of Tail from Head along y. offset_ew is positive when Tail is above Head. direction is level when the offset is 0.02 or less."
  },
  "applies_to": "All three intensities of each style.",
