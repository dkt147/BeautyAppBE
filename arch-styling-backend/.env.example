# ARCH API settings. Copy to .env and fill in the blanks. Never commit .env.
# A variable set in the real environment wins over this file.

# dev | staging | production. Production hides /v1/dev/* and /live (404).
ARCH_ENV=production
# Long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
ARCH_JWT_SECRET=put_a_random_long_secret_here

# Base for image URLs and the password reset link. Test server's IP for now;
# change to https://api.cbygroyals.com when the domain and HTTPS are live.
ARCH_PUBLIC_BASE_URL=http://2.25.159.7:8010
# Optional. Defaults to <ARCH_PUBLIC_BASE_URL>/reset-password
# ARCH_RESET_LINK_URL=

# Email (QA item 6): 2FA codes, reset links, account emails.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
# Gmail: an app password (Google account > Security > App passwords)
SMTP_PASS=
# Optional: SMTP_FROM (defaults to SMTP_USER), SMTP_FROM_NAME=ARCH, SMTP_TLS=starttls|ssl|none

# SMS (QA item 6): phone codes (screen 65) and SMS 2FA codes, via Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Gmail already keeps a copy under Sent Mail; set true only for a provider that doesn't
SMTP_SAVE_TO_SENT=false

# App links for the reset link (QA item 7)
ARCH_APPLE_TEAM_ID=
# ARCH_APPLE_BUNDLE_ID=com.cbygroyals.arch
# Android signing certificate SHA-256 fingerprints, comma separated (not received yet)
ARCH_ANDROID_CERT_SHA256=

# Rate limits (QA item 4); on by default except on staging.
# ARCH_RATE_LIMITS=true

# Twilio SMS
TWILIO_ACCOUNT_SID=your_account_sid_here
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=phone_number
SMTP_SAVE_TO_SENT=false