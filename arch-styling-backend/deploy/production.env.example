# ARCH API · production server settings (QA report items 2, 4, 5, 7).
# Copy to the server (for example /etc/arch/production.env), fill in the
# blanks, and load it in the service that starts uvicorn. Never commit the
# filled-in copy.

# Dev tools (/v1/dev/*, /live) answer 404 on production.
ARCH_ENV=production
ARCH_JWT_SECRET=

# Base for media URLs and the reset link. The test server's IP until the
# domain and HTTPS are live, then https://api.cbygroyals.com (item 5).
ARCH_PUBLIC_BASE_URL=http://2.25.159.7:8010

# Password reset link (item 7): <ARCH_PUBLIC_BASE_URL>/reset-password?token=<token>
# (override with ARCH_RESET_LINK_URL)
# Universal links / app links for that URL (fill in to switch them on)
ARCH_APPLE_TEAM_ID=FTQ9GSY7QA
ARCH_ANDROID_CERT_SHA256=

# Rate limits (item 4). On by default on production. Sizes can be overridden:
ARCH_RATE_LIMITS=true
# ARCH_RL_REGISTER_MAX=30                 successful sign-ups per address per hour
# ARCH_RL_REGISTER_FAILED_EMAIL_MAX=10    failed sign-ups per email per hour
# ARCH_RL_LOGIN_FAILED_EMAIL_MAX=10       failed sign-ins per email per 15 minutes
# ARCH_RL_LOGIN_FAILED_ADDRESS_MAX=30     failed sign-ins per address per 15 minutes

# Email (item 6)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# SQLite lock wait in milliseconds (item 1)
ARCH_DB_BUSY_TIMEOUT_MS=5000
