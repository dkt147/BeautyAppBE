# ARCH API · staging settings, for QA (QA report items 2 and 4).
# Port 8011, next to production on 8010, with its own data folder and secret.
# Copy to .env.staging in the project root, fill in the blanks, and start it
# with run_staging.sh (or run_staging.bat). Never commit the filled-in copy.

# Dev tools on: /v1/dev/grant-membership (membership tests 65 to 72 without
# store billing), /v1/dev/reset-test-user (reruns onboarding 14 to 18),
# /v1/dev/run-jobs, scan-debug and /live.
ARCH_ENV=staging
ARCH_RATE_LIMITS_ENABLED=false
ARCH_PUBLIC_BASE_URL=http://2.25.159.7:8011

# Use a different secret from production, so tokens don't work across the two.
ARCH_JWT_SECRET=
# Separate accounts, scans and media from production.
ARCH_DATA_DIR=data/staging

# Email for 2FA codes and reset links (can be the same account as production)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# SMS (QA item 6): phone codes (screen 65) and SMS 2FA codes, via Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Gmail already keeps a copy under Sent Mail; set true only for a provider that doesn't
SMTP_SAVE_TO_SENT=false

ARCH_APPLE_TEAM_ID=FTQ9GSY7QA
