# ARCH API · staging server settings, for QA (QA report items 2 and 4).
# A separate server (or port) from production, with its own data folder.

# Dev tools stay on for QA: grant-membership (tests 65 to 72 without store
# billing), reset-test-user (reruns onboarding 14 to 18), run-jobs, scan-debug.
ARCH_ENV=staging
ARCH_JWT_SECRET=
ARCH_DATA_DIR=/var/lib/arch-staging

ARCH_PUBLIC_BASE_URL=https://staging-api.cbygroyals.com

# Rate limits are off by default on staging, so QA can sign up and sign in repeatedly.
ARCH_RATE_LIMITS=false
